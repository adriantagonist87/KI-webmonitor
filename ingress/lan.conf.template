# Optional HTTP LAN endpoint. App session, subnet and exact Origin checks apply
# equally to the application, files, noVNC and its WebSocket connection.
map $http_origin $__ORIGIN_VARIABLE__ {
  default 0;
  "" 1;
  "__LAN_URL__" 1;
}
server {
  listen 8083;
  server_name __LAN_IP__;
  allow __LAN_SUBNET__;
  deny all;
  if ($http_host != "__LAN_AUTHORITY__") { return 444; }
  if ($__ORIGIN_VARIABLE__ = 0) { return 403; }
  client_max_body_size 1m;
  proxy_buffering off;
  proxy_max_temp_file_size 0;
  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy same-origin always;
  proxy_hide_header X-Frame-Options;
  add_header X-Frame-Options $kiwm_frame_policy always;
  set $kiwm_app http://app:8000;
  set $kiwm_browser http://browser:6080;
  # An exact match prevents nginx's automatic /browser -> /browser/ redirect
  # from intercepting the app's browser help page or exposing its internal port.
  location = /browser {
    proxy_pass $kiwm_app;
    proxy_set_header Host $http_host;
    proxy_set_header X-KIWM-Client-IP $remote_addr;
    proxy_set_header Authorization "";
    proxy_set_header X-Forwarded-Proto http;
    proxy_read_timeout 900s;
  }
  location = /_kiwm_session {
    internal;
    proxy_pass $kiwm_app/auth/check;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_set_header Host $http_host;
    proxy_set_header X-KIWM-Client-IP $remote_addr;
    proxy_set_header Authorization "";
  }
  location @kiwm_login { return 303 /login?next=/browser; }
  location /browser/ {
    auth_request /_kiwm_session;
    error_page 401 = @kiwm_login;
    rewrite ^/browser/(.*)$ /$1 break;
    proxy_pass $kiwm_browser;
    proxy_http_version 1.1;
    proxy_set_header Authorization "";
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_read_timeout 3600s;
  }
  location = /transfer/preview {
    client_max_body_size 513m;
    proxy_request_buffering off;
    proxy_http_version 1.1;
    proxy_pass $kiwm_app;
    proxy_set_header Host $http_host;
    proxy_set_header X-KIWM-Client-IP $remote_addr;
    proxy_set_header Authorization "";
    proxy_set_header X-Forwarded-Proto http;
    proxy_read_timeout 900s;
  }
  location / {
    proxy_pass $kiwm_app;
    proxy_set_header Host $http_host;
    proxy_set_header X-KIWM-Client-IP $remote_addr;
    proxy_set_header Authorization "";
    proxy_set_header X-Forwarded-Proto http;
    proxy_read_timeout 900s;
  }
}
