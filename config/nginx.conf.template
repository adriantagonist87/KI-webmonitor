map $http_origin $browser_origin_allowed {
  default 0;
  "" 1;
  "http://localhost:__BROWSER_PORT__" 1;
  "http://127.0.0.1:__BROWSER_PORT__" 1;
}
server {
  listen 8080;
  server_name localhost;
  client_max_body_size 1m;
  # Downloads stream directly; never spill ZIPs/exports into the bounded /tmp.
  proxy_buffering off;
  proxy_max_temp_file_size 0;
  location = /transfer/preview {
    client_max_body_size 513m;
    proxy_request_buffering off;
    proxy_http_version 1.1;
    proxy_pass http://app:8000;
    proxy_set_header Host $http_host;
    proxy_read_timeout 900s;
  }
  location / {
    proxy_pass http://app:8000;
    proxy_set_header Host $http_host;
    proxy_read_timeout 900s;
  }
}
server {
  listen 8081;
  server_name localhost;
  if ($browser_origin_allowed = 0) { return 403; }
  location / {
    proxy_pass http://browser:6080;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_read_timeout 3600s;
  }
}
server {
  listen 8082;
  server_name localhost;
  location / { proxy_pass http://mailpit:8025; }
}
