# KI-Webmonitor · persönliche Einstellungen für Compose oder Portainer
VERSION=1.5.12
WEB_PORT=8765
BROWSER_PORT=8766

# Optional: leer verwendet die gespeicherten Einstellungen der Weboberfläche.
KIWM_OMLX_URL=
KIWM_OMLX_API_KEY=
KIWM_MODEL=

# Erst nach Veröffentlichung im eigenen GitHub-Repository setzen:
# IMAGE_PREFIX=ghcr.io/OWNER/REPOSITORY
# Ohne IMAGE_PREFIX werden lokal geladene Release-Images verwendet.

# Telegram: off = alle aus, projects = Projektvorgaben, all = alle ein.
# SMTP: ENABLED true/false, TLS starttls/ssl, PORT z. B. 587.
# Leer lassen verwendet auch hier die Webeinstellungen.
KIWM_TELEGRAM_BOT_TOKEN=
KIWM_TELEGRAM_CHAT_ID=
KIWM_TELEGRAM_MODE=
KIWM_SMTP_ENABLED=
KIWM_SMTP_HOST=
KIWM_SMTP_PORT=
KIWM_SMTP_TLS=
KIWM_SMTP_USER=
KIWM_SMTP_PASSWORD=
KIWM_SMTP_FROM=
KIWM_SMTP_TO=

# Anmeldung: beide Werte setzen. Passwort mindestens 12 Zeichen.
# Nur in App; niemals an KI-Modelle oder Gateway weitergegeben.
KIWM_ADMIN_USERNAME=
KIWM_ADMIN_PASSWORD=
# Sitzungsdauer in Stunden; 1 bis 720, Standard 7 Tage.
KIWM_SESSION_HOURS=168

# Optional: externer HTTPS-Hostname hinter Cloudflare Tunnel (LAN-Stack).
KIWM_PUBLIC_URL=
